APP_ENV=development
API_V1_PREFIX=/api/v1
DATA_DIR=./data/studies
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
ENABLE_DOCS=true
AUTO_CREATE_SCHEMA=true
JWT_SECRET_KEY=change-this-to-a-random-secret-at-least-32-characters
JWT_ISSUER=dexa-backend
JWT_AUDIENCE=dexa-frontend
DATA_ENCRYPTION_KEYS=
ML_STUDY_MODULE=app.external_ml.inference
ENABLE_EXPERIMENTAL_BENCHMARK_HEADS=false
BATCH_TIMEOUT_SECONDS=180
LOG_LEVEL=INFO
