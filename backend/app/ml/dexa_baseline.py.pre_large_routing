}

class DexaBaselineAdapter:
    """Study-aware deterministic adapter used until trained weights are available."""

    MODEL_NAME = "dexa-baseline"
    MODEL_VERSION = "1.6.2-v68.5"

    def predict_study(self, images):
        from app.schemas.prediction import Defect, ImagePrediction, ModelInfo, ModelPrediction
        from uuid import UUID

        # Deduplicate computation, not output: every original DICOM must receive
        # a result row, while pixel-identical duplicates reuse the same prediction.
        unique = []
        groups = []
        seen = {}
        for image_id, pixels, metadata in images:
            key = hashlib.md5(np.ascontiguousarray(pixels).tobytes()).hexdigest()
            idx = seen.get(key)
            if idx is None:
                idx = len(unique)
                seen[key] = idx
                unique.append((image_id, pixels, metadata))
            groups.append(idx)
        routed = classify_study([x[1] for x in unique])
        route_by_index = {route.image_index: route for route in routed}
        results = []
        defects = []
        cached = []
        for unique_index, (image_id, pixels, metadata) in enumerate(unique):
            route = route_by_index.get(unique_index)
            if route is None:
                raise ValueError(f"missing anatomical route for image index {unique_index}")
            if route.region == "unknown":
                raise ValueError("anatomical region could not be determined")
            status, confidence, violations, findings = evaluate_quality(pixels, route.region, metadata)
            score = 1.0 - confidence if status == "issue_detected" else confidence
            deterministic_risk = float(np.clip(confidence if status == "issue_detected" else 0.0, 0.0, 1.0))
            model_risks = _quality_probabilities(pixels, route.region)
            quality_prob = float(np.clip(max([deterministic_risk, *model_risks]), 0.0, 1.0))
            # Candidate anatomy geometry is exposed for visualization only.
            # It is explicitly not a defect mask/segmentation.
            from app.schemas.prediction import AnatomyLocalization, BBoxROI
            anatomy_localization = None
            if route.region == "spine":
                from app.ml.spine_localizer import localize_spine
                sloc = localize_spine(pixels)
                anatomy_localization = AnatomyLocalization(
                    bbox=BBoxROI(x=sloc.bbox[0], y=sloc.bbox[1], width=sloc.bbox[2], height=sloc.bbox[3]),
                    centerline=list(sloc.centerline),
                    confidence=sloc.confidence,
                    axis_degrees_physical=sloc.axis_degrees_physical,
                )
            elif route.region in {"femur_right", "femur_left"}:
                from app.ml.hip_localizer import localize_hip
                side = "right" if route.region == "femur_right" else "left"
                hloc = localize_hip(pixels, side=side)
                anatomy_localization = AnatomyLocalization(
                    bbox=BBoxROI(x=hloc.bone_bbox[0], y=hloc.bone_bbox[1], width=hloc.bone_bbox[2], height=hloc.bone_bbox[3]),
                    shaft_bbox=BBoxROI(x=hloc.shaft_bbox[0], y=hloc.shaft_bbox[1], width=hloc.shaft_bbox[2], height=hloc.shaft_bbox[3]),
                    confidence=hloc.confidence,
                    side=side,
                    physical_margin_mm=hloc.physical_margin_mm,
                )
            result = ImagePrediction(
                image_id=image_id,
                study_uid=metadata.get("StudyInstanceUID") or None,
                image_uid=metadata.get("SOPInstanceUID") or None,
                anatomical_region=REGION_OUTPUT.get(route.region, "Проксимальный отдел бедра"),
                quality_class=1 if status == "issue_detected" else 0,
                quality_score=score,
                confidence=confidence,
                quality_prob=quality_prob,
                violation_type=[term_name(code) for code in violations if code in {"SPINE_POSITION","SPINE_AXIS","SPINE_ARTIFACT","HIP_POSITION_ROTATION","HIP_ROI"}],
                findings=[term_name(code) for code in findings],
                processing_status="success",
                anatomy_localization=anatomy_localization,
            )
            cached.append((route, result, violations, findings))
            for code in [*violations, *findings]:
                defects.append(Defect(
                    type=code,
                    label=term_name(code),
                    confidence=confidence,
                    image_id=image_id,
                    roi={"type": "bbox", "x": 0.0, "y": 0.0, "width": 1.0, "height": 1.0},
                ))
        # Expand cached predictions back to all source images, preserving image IDs.
        if len(groups) != len(unique):
            expanded = []
            for original_idx, group_idx in enumerate(groups):
                original_id, _, original_metadata = images[original_idx]
                _, cached_result, _, _ = cached[group_idx]
                expanded.append(cached_result.model_copy(update={
                    "image_id": original_id,
                    "study_uid": original_metadata.get("StudyInstanceUID") or None,
                    "image_uid": original_metadata.get("SOPInstanceUID") or None,
                }))
            results = expanded
        else:
            results = [x[1] for x in cached]

        has_issue = any(x.quality_class == 1 for x in results)
        scores = [x.quality_score for x in results if x.quality_score is not None]
        return ModelPrediction(
            quality_status="issue_detected" if has_issue else "acceptable",
            quality_score=min(scores) if scores else None,
            defects=defects,
            model=ModelInfo(name=self.MODEL_NAME, version=self.MODEL_VERSION),
            results=results,
        )

    def predict(self, image: np.ndarray, *, image_id, metadata: dict):
        return self.predict_study([(image_id, image, metadata)])
